{
  "manifest_version": 3,
  "name": "Ori VM Host",
  "version": "1.0.0",
  "description": "Ori language host runtime — run Ori programs as a Chrome extension with an options/settings page",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Ori VM Host",
    "default_popup": "options.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}